diff --git a/jlm_fin_eval/api/metrics.py b/jlm_fin_eval/api/metrics.py
index c2e4dda..31c5ae6 100644
--- a/jlm_fin_eval/api/metrics.py
+++ b/jlm_fin_eval/api/metrics.py
@@ -36,6 +36,20 @@ def f1_norm_fn(items):  # This is a passthrough function
     return items
 
 
+@register_metric(
+    metric="chabsa_f1",
+    higher_is_better=True,
+    output_type="generate_until",
+)
+def chabsa_f1_fn(items):  # This is a passthrough function (generate_until variant)
+    # In generate_until, ConfigurableTask.process_results first tries
+    # `metric_fn(references=[gold], predictions=[pred])`; for a single-arg
+    # function that raises TypeError, so lm-eval falls back to
+    # `metric_fn([gold, pred])`, handing us the (gold, pred) pair to pass
+    # through to the macro-F1 aggregation.
+    return items
+
+
 @register_metric(
     metric="map",
     higher_is_better=True,
