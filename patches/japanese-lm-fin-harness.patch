+task: chabsa_gen
+dataset_path: jlm_fin_eval/datasets/chabsa/chabsa.py
+dataset_name: chABSA
+output_type: generate_until
+training_split: null
+validation_split: null
+test_split: test
+description: "以下のセンテンスにおける、ターゲットのセンチメントをpositiveかnegativeで答えてください。ただし、最終的な回答（positive または negative）は \\boxed{} の中に記入しなさい。\n\n\n"
+target_delimiter: ""
+fewshot_delimiter: "\n\n"
+doc_to_text: "センテンス: {{sentence}}\nターゲット: {{target}}\n回答:"
