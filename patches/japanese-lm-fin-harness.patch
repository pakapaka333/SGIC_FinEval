diff --git a/jlm_fin_eval/tasks/fp2/utils.py b/jlm_fin_eval/tasks/fp2/utils.py
index b279c72..ade00da 100644
--- a/jlm_fin_eval/tasks/fp2/utils.py
+++ b/jlm_fin_eval/tasks/fp2/utils.py
@@ -17,6 +17,27 @@ def doc_to_choices_00(doc):
     return choices
 
 
+def doc_to_text_boxed(doc):
+    doc_text = "【問題】\n" + doc["question"] + "\n"
+    if doc["context"] and doc["context"] != "":
+        doc_text += doc["context"] + "\n"
+    doc_text += "\n【選択肢】\n"
+    for number, choice_text in enumerate(doc["choices"]["text"], start=1):
+        doc_text += str(number) + ": " + choice_text + "\n"
+    doc_text += (
+        "\n最終的な答えとなる選択肢の番号（1～"
+        + str(len(doc["choices"]["text"]))
+        + "）を \\boxed{} の中に記入してください。\n"
+    )
+    return doc_text
+
+
+def doc_to_target_boxed(doc):
+    # Map the gold answer id to its 1-based position shown in doc_to_text_boxed.
+    position = doc["choices"]["id"].index(doc["answer"])
+    return str(position + 1)
+
+
