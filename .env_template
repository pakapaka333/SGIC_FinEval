# Copy this file to `.env` and fill in the values.

# Absolute path to the root of this repository (required)
PROJECT_ROOT=""

# Hugging Face token, used to download models/datasets (required)
HF_TOKEN=""

# OpenAI API key, used by the LLM judge of dr-finance-instruction
# (required for that benchmark)
OPENAI_API_KEY=""

# Optional: custom cache directories. Uncomment to override the defaults.
# UV_CACHE_DIR=""
# HF_HOME=""
# HUGGINGFACE_HUB_CACHE=""
